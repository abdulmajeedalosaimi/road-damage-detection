{
  "purpose": "http_input_validation",
  "service_url": "http://127.0.0.1:8765",
  "tests": [
    {
      "test": "Missing file field",
      "expected_status": 422,
      "actual_status": 422,
      "service_healthy_after_request": true,
      "response": {
        "detail": [
          {
            "type": "missing",
            "loc": [
              "body",
              "file"
            ],
            "msg": "Field required",
            "input": null
          }
        ]
      },
      "passed": true
    },
    {
      "test": "Empty file",
      "expected_status": 400,
      "actual_status": 400,
      "service_healthy_after_request": true,
      "response": {
        "detail": "Uploaded file is empty."
      },
      "passed": true
    },
    {
      "test": "Invalid bytes disguised as PNG",
      "expected_status": 400,
      "actual_status": 400,
      "service_healthy_after_request": true,
      "response": {
        "detail": "File is not a readable image."
      },
      "passed": true
    },
    {
      "test": "Unsupported GIF format",
      "expected_status": 415,
      "actual_status": 415,
      "service_healthy_after_request": true,
      "response": {
        "detail": "Only JPEG and PNG images are supported."
      },
      "passed": true
    },
    {
      "test": "Upload exceeds byte limit",
      "expected_status": 413,
      "actual_status": 413,
      "service_healthy_after_request": true,
      "response": {
        "detail": "Upload exceeds 10 MiB."
      },
      "passed": true
    },
    {
      "test": "Image exceeds pixel limit",
      "expected_status": 413,
      "actual_status": 413,
      "service_healthy_after_request": true,
      "response": {
        "detail": "Image exceeds pixel limit."
      },
      "passed": true
    }
  ],
  "passed": 6,
  "total": 6
}